# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
# 项目虚拟环境由 start.bat 首次运行时自动创建（参考归档项目 pixelforge-2026-10），
# 不入库；.venv.bak* 保留给将来「版本越界时把旧环境挪到一边重建」用
.venv.bak*/
venv/
env/

# ---------- Node / 前端 ----------
node_modules/
frontend/dist/
frontend/.vite/
# vite build 每次会在 frontend/ 根留下 config 时间戳临时文件
vite.config.ts.timestamp-*
*.tsbuildinfo
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- 本地模型权重（GB 级，不入库） ----------
models/
*.safetensors
*.ckpt
*.pt
*.pth
*.onnx

# ---------- 运行时数据（生成产物 / 项目画布 / 参考图） ----------
data/*
!data/.gitkeep

# ---------- 冒烟测试与临时产物 ----------
smoke-*.png
.tmp/
tmp/
# 效果对比图（本地留档，不入库）
compare-*.png

# ---------- 环境与密钥 ----------
.env
.env.*
!.env.example
*.key
secrets.json

# ---------- 编辑器 / 系统 ----------
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ---------- 日志 ----------
*.log
logs/

# ---------- 工作区记忆（本地会话日志，不入库） ----------
.workbuddy/

# ---------- 本地验证产物 ----------
backend/_gpu_out/
backend/out_*.png

# 图标生成的中间产物：候选原图/精修图/展示拼图都是本地留档。
# 最终交付的 favicon（frontend/public/favicon*）要入库，所以不忽略 public/。
tools/_icon/
tools/icon_*.png
